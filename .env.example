# Public site URL — used for SEO canonical URLs, sitemap, Open Graph and JSON-LD
NUXT_PUBLIC_SITE_URL=https://phanath.dev

# Optional: endpoint the contact form POSTs to once an email API is connected.
# Leave empty to keep the form in "simulated" mode (no network request).
# Example providers: Formspree, Web3Forms, a Nuxt server route -> Resend, etc.
NUXT_PUBLIC_CONTACT_ENDPOINT=
